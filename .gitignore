# Dependencies and build output
node_modules/
dist/
.next/
.turbo/
out/
*.tsbuildinfo

# Generated. `prisma generate` recreates this from the schema; committing it
# means a stale client can win over the schema it claims to match.
packages/database/generated/

# Secrets.
#
# Deliberately broad: `.env*` with a single exception, rather than a list of
# known filenames. A list only protects the names somebody thought of, and the
# first .env.production or .env.staging anyone creates is not on it.
.env*
!.env.example

# Test and coverage artefacts
coverage/
test-results/
playwright-report/
.nyc_output/

# Local runtime
*.log
docker/volumes/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Session notes, not project history
.remember/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Playwright's saved sign-in, recreated on every run.
.auth/

# Claude Code session transcripts, if a home-directory copy ever lands here.
# These are conversation logs, not project files, and they contain whatever was
# pasted into a session — on this project that has included OAuth client secrets
# and an ngrok authtoken. This repository has a GitHub remote; one `git add -A`
# is all it would take.
claude/
