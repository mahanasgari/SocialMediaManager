{
  "name": "@smm/providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capabilities": {
      "development": "./src/capabilities/index.ts",
      "types": "./dist/capabilities/index.d.ts",
      "default": "./dist/capabilities/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "gate:budgets": "vitest run src/contract.test.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@smm/config": "workspace:*"
  },
  "files": [
    "dist"
  ]
}
