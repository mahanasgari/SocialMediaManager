// Phase 1 schema — identity, tenancy, and the infrastructure the publishing
// pipeline will lean on. Content, media, inbox and analytics models arrive in
// Phases 3, 4, 6 and 7; see DATABASE.md for the full target shape.
//
// Two conventions are load-bearing rather than stylistic:
//
//   * Every tenant-scoped model carries `workspaceId` (or `organizationId` for
//     org-level models) AND `deletedAt`. The tenancy client extension refuses
//     to query a tenant-scoped model without a scope, and filters soft-deleted
//     rows automatically. See packages/database/src/tenancy.ts.
//
//   * Composite indexes lead with the tenancy column, because every query is
//     already filtered by it and an index that does not lead with it cannot
//     serve those queries.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  ADMIN
  MANAGER
  EDITOR
  AUTHOR
  APPROVER
  ANALYST
  CLIENT
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Delivery state for the transactional outbox. Delivery is AT-LEAST-ONCE:
/// every consumer must be idempotent. See ARCHITECTURE.md section 3.
enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

// ---------------------------------------------------------------------------
// Identity and tenancy
// ---------------------------------------------------------------------------

/// Billing and entitlement boundary.
model Organization {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name         String
  slug         String    @unique
  plan         String    @default("self-hosted")
  entitlements Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  workspaces  Workspace[]
  memberships Membership[]
  invites     Invite[]
  auditLogs   AuditLog[]

  @@index([deletedAt])
}

/// Content and isolation boundary. An agency's client, or a brand.
model Workspace {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  timezone       String    @default("UTC")
  settings       Json      @default("{}")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  /// Set when soft-deleted. Surfaced in the UI as a real date, never "soon".
  purgeAt        DateTime?

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  invites        Invite[]
  auditLogs      AuditLog[]
  socialAccounts SocialAccount[]
  posts          Post[]
  media          MediaAsset[]

  campaigns  Campaign[]
  labels     Label[]
  templates  Template[]
  utmPresets UtmPreset[]
  exportJobs ExportJob[]
  recurrences Recurrence[]


  @@unique([organizationId, slug])
  @@index([organizationId, deletedAt])
  postingSlots PostingSlot[]
  analyticsSnapshots AnalyticsSnapshot[]
}

model User {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email           String    @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  timezone        String    @default("UTC")
  locale          String    @default("en")
  emailVerifiedAt DateTime?
  /// User deletion anonymises rather than cascades: content belongs to the
  /// workspace, so authorship becomes a tombstone and posts survive.
  anonymizedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships        Membership[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  sentInvites        Invite[]            @relation("InvitedBy")
  auditLogs          AuditLog[]
  posts              Post[]
  comments           PostComment[]
  notifications      Notification[]

  createdTemplates Template[]
  exportJobs       ExportJob[]
  recurrences Recurrence[]


  @@index([email])
  providerSettings ProviderSetting[]
}

/// A null workspaceId means the membership is organization-wide.
model Membership {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String    @db.Uuid
  organizationId String    @db.Uuid
  workspaceId    String?   @db.Uuid
  role           Role
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, workspaceId])
  @@index([organizationId, deletedAt])
  @@index([workspaceId, deletedAt])
  @@index([userId])
}

/// Sessions are authoritative here rather than in a JWT, so they are listable
/// in a "your devices" view and revocable immediately. Redis caches them with a
/// short TTL; revocation deletes the row and busts the cache.
model Session {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

/// Single-use. Accepting JOINS the existing organization; it never creates one.
model Invite {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String       @db.Uuid
  workspaceId    String?      @db.Uuid
  email          String
  role           Role
  tokenHash      String       @unique
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId, status])
  @@index([workspaceId, deletedAt])
  @@index([email, status])
}

/// Admin actions are audited exactly like user actions — an audit trail with a
/// hole where the most powerful actor stands is not an audit trail.
///
/// On workspace purge these rows are retained in MINIMISED form (actor, action,
/// timestamp, no payload). A deletion record that deletes itself is not a record.
model AuditLog {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String   @db.Uuid
  workspaceId    String?  @db.Uuid
  actorId        String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  metadata       Json     @default("{}")
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
// Infrastructure
// ---------------------------------------------------------------------------

/// Transactional outbox. The domain write and the outbox row commit together;
/// a dispatcher drains them into BullMQ. This closes the "committed the post,
/// crashed before enqueueing" window that would otherwise leave a SCHEDULED row
/// nobody ever picks up.
///
/// Deliberately NOT tenant-scoped in the guard sense: the dispatcher is a system
/// principal that must drain across all workspaces. workspaceId is carried so
/// the consumer can establish tenancy context downstream.
model Outbox {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String?      @db.Uuid
  workspaceId    String?      @db.Uuid
  aggregateType  String
  aggregateId    String
  eventType      String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  createdAt      DateTime     @default(now())
  dispatchedAt   DateTime?
  nextRetryAt    DateTime?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

// ---------------------------------------------------------------------------
// Connected social accounts
// ---------------------------------------------------------------------------

enum SocialAccountStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
  DISABLED
}

/// A connected social account.
///
/// UNIQUENESS IS PER WORKSPACE, deliberately. Two workspaces may connect the
/// same underlying Facebook Page — an agency and its client both doing so is
/// normal, not an edge case. A global unique constraint would forbid the agency
/// case outright, and inbound webhooks fan out to every workspace holding the
/// account rather than resolving to one.
model SocialAccount {
  id                String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String              @db.Uuid
  organizationId    String              @db.Uuid
  provider          String
  /// The platform's own identifier. Never conflated with `id`.
  providerAccountId String
  handle            String
  displayName       String
  avatarUrl         String?
  /// Surfaces this account can post to (feed, reel, story, ...).
  surfaces          String[]
  /// Irreducibly provider-specific: Mastodon instance URL and its dynamically
  /// registered client credentials, Facebook page id, IG business id, Telegram
  /// chat id, Pinterest default board, YouTube channel id.
  platformMeta      Json                @default("{}")
  status            SocialAccountStatus @default(ACTIVE)
  statusReason      String?
  lastSyncedAt      DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  deletedAt         DateTime?

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  credential    OAuthCredential?
  variants      PostVariant[]
  metrics       AccountMetric[]
  conversations Conversation[]

  @@unique([workspaceId, provider, providerAccountId])
  /// Non-unique on purpose: this is the inbound-webhook fan-out lookup.
  @@index([provider, providerAccountId])
  @@index([workspaceId, status, deletedAt])
}

/// OAuth credentials, encrypted at rest.
///
/// Separate from SocialAccount so the account row (history, attribution) can
/// survive a disconnect while the credential is HARD-DELETED. A soft-deleted
/// secret is still a secret sitting in the database.
model OAuthCredential {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  socialAccountId String    @unique @db.Uuid
  workspaceId     String    @db.Uuid
  /// AES-256-GCM envelope ciphertext: { v, keyId, iv, tag, ciphertext }.
  accessToken     String
  refreshToken    String?
  expiresAt       DateTime?
  scopes          String[]
  /// Which KEK wrapped this record's DEK, so rotation can find what to re-wrap.
  keyId           String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([expiresAt])
  @@index([keyId])
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

/// AUTHORITATIVE state, written only by the publishing pipeline.
enum VariantStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PREPARING_MEDIA
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  MISSED
  NEEDS_REVIEW
}

/// DERIVED from the variants by a pure reducer — never written directly, except
/// for PENDING_APPROVAL and APPROVED, which are editorial gates with no variant
/// counterpart.
enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
  CANCELLED
  MISSED
  NEEDS_REVIEW
}

enum PublishAttemptStatus {
  IN_FLIGHT
  SUCCEEDED
  FAILED
  RATE_LIMITED
  RECONCILED
}

/// What the author wrote, once.
model Post {
  id             String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String     @db.Uuid
  organizationId String     @db.Uuid
  authorId       String?    @db.Uuid
  status         PostStatus @default(DRAFT)
  baseContent    String     @default("")
  /// Absolute UTC. NEVER rewritten by a DST shift — only recurrence expansion
  /// is zone-aware.
  scheduledAt    DateTime?
  /// IANA zone the author chose, kept alongside the absolute instant so the UI
  /// can render it back in the zone they meant.
  timezone       String     @default("UTC")
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  /// SetNull, not Cascade. Deleting a campaign must not delete a quarter of
  /// published history along with it — the posts went out and their metrics are
  /// real whether or not the campaign that grouped them still exists.
  campaignId String? @db.Uuid

  /// The rule that generated this post, if any.
  ///
  /// SetNull rather than Cascade, for the same reason as campaignId: deleting a
  /// recurring schedule must not delete the posts it already produced. Those
  /// went out, or are about to, and they belong to the calendar rather than to
  /// the rule.
  recurrenceId String? @db.Uuid

  /// The occurrence this post materialises, as an absolute instant.
  ///
  /// Stored separately from scheduledAt because the two can legitimately
  /// diverge: someone may drag a generated post to a different time, and the
  /// expansion must still recognise that this occurrence is already covered
  /// rather than creating a second post for it.
  occurrenceAt DateTime?

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  campaign  Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recurrence Recurrence?  @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  variants  PostVariant[]
  media     PostMedia[]
  approval  Approval?
  comments  PostComment[]
  labels    PostLabel[]

  @@index([workspaceId, status, scheduledAt])
  @@index([workspaceId, deletedAt, createdAt])
  @@index([workspaceId, campaignId])
  /// The expansion job's idempotency. Running it twice for the same occurrence
  /// must produce one post, not two — and it runs on every worker tick.
  @@unique([recurrenceId, occurrenceAt])
}

/// One row per target account. The load-bearing table.
///
/// Rows rather than a JSON blob because partial failure is the NORMAL outcome —
/// one channel accepts while another rejects an aspect ratio — and each channel
/// must retry independently, be filterable, and carry its own idempotency key.
model PostVariant {
  id                 String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId             String        @db.Uuid
  workspaceId        String        @db.Uuid
  organizationId     String        @db.Uuid
  socialAccountId    String        @db.Uuid
  surface            String        @default("feed")
  /// Null means inherit from the post.
  contentOverride    String?
  /// Validated by a per-provider zod schema on write. Relational where we query,
  /// JSON where the shape is genuinely open-ended per provider.
  platformOptions    Json          @default("{}")
  status             VariantStatus @default(DRAFT)
  attempts           Int           @default(0)
  lastError          String?
  lastErrorCode      String?
  /// sha256(variantId || contentHash). Stable across retries.
  idempotencyKey     String?
  /// Mutation-tolerant, computed BEFORE publish. Providers rewrite what you send
  /// — link shortening, unicode normalisation, truncation — so reconciliation
  /// matches on a normalised subset, never on exact text.
  fingerprint        String?
  remoteId           String?
  remoteUrl          String?
  publishedAt        DateTime?
  publishedLate      Boolean       @default(false)
  latenessSeconds    Int?
  /// X charges per post and prices link posts far higher; shown before scheduling.
  estimatedCostCents Int?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  metrics         PostMetric[]
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  publishAttempts PublishAttempt[]

  @@unique([postId, socialAccountId, surface])
  @@index([workspaceId, status])
  @@index([status, postId])
  @@index([socialAccountId, status])
}

/// Written BEFORE the provider call, in its own committed transaction.
///
/// A stale IN_FLIGHT row triggers RECONCILIATION rather than a blind retry: the
/// post may have landed and the response been lost, and republishing is
/// unrecoverable.
model PublishAttempt {
  id                 String               @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postVariantId      String               @db.Uuid
  workspaceId        String               @db.Uuid
  idempotencyKey     String
  status             PublishAttemptStatus @default(IN_FLIGHT)
  startedAt          DateTime             @default(now())
  finishedAt         DateTime?
  providerRequestId  String?
  providerResponseId String?
  errorCode          String?
  /// Fencing token from the per-account mutex. A holder whose lease expired
  /// mid-call must not be able to write its result.
  fenceToken         Int?

  variant PostVariant @relation(fields: [postVariantId], references: [id], onDelete: Cascade)

  @@index([status, startedAt])
  @@index([postVariantId, startedAt])
}

// ---------------------------------------------------------------------------
// Analytics
// ---------------------------------------------------------------------------

/// Post-level metrics over time.
///
/// Typed columns are NULLABLE and that is semantic: the UI must distinguish
/// "zero" from "this platform does not report this". Rendering "0 impressions"
/// for a network that never reports impressions is worse than rendering "—".
model PostMetric {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String   @db.Uuid
  postVariantId  String   @db.Uuid
  capturedAt     DateTime @default(now())
  impressions    Int?
  reach          Int?
  views          Int?
  likes          Int?
  comments       Int?
  shares         Int?
  saves          Int?
  clicks         Int?
  videoViews     Int?
  watchTimeMs    Int?
  engagementRate Float?
  /// The provider payload, verbatim. Nulled after 90 days by cleanup; the
  /// normalized columns above are kept.
  raw            Json?
  source         String   @default("poll")

  variant PostVariant @relation(fields: [postVariantId], references: [id], onDelete: Cascade)

  @@index([postVariantId, capturedAt])
  @@index([workspaceId, capturedAt])
}

/// Daily account snapshots — follower growth and posting volume.
model AccountMetric {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String   @db.Uuid
  socialAccountId String   @db.Uuid
  capturedAt      DateTime @default(now())
  followers       Int?
  following       Int?
  postCount       Int?
  followerGrowth  Int?
  raw             Json?

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([socialAccountId, capturedAt])
  @@index([workspaceId, capturedAt])
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model MediaAsset {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  organizationId String    @db.Uuid
  uploadedById   String?   @db.Uuid
  /// Server-generated. A client filename is metadata and never touches a path.
  storageKey     String    @unique
  filename       String
  mime           String
  bytes          Int
  width          Int?
  height         Int?
  durationMs     Int?
  altText        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  renditions MediaRendition[]
  postMedia  PostMedia[]

  @@index([workspaceId, deletedAt, createdAt])
}

/// Attaches media to a post, in order.
model PostMedia {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId  String  @db.Uuid
  postId       String  @db.Uuid
  mediaAssetId String  @db.Uuid
  position     Int     @default(0)
  altText      String?

  post  Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([postId, mediaAssetId])
  @@index([workspaceId])
  @@index([postId, position])
}

// ---------------------------------------------------------------------------
// Approvals and collaboration
// ---------------------------------------------------------------------------

enum ApprovalState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum ApprovalMode {
  /// Any single approver can decide.
  ANY
  /// Every named approver must approve.
  ALL
}

model Approval {
  id            String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId   String        @db.Uuid
  postId        String        @unique @db.Uuid
  requestedById String        @db.Uuid
  state         ApprovalState @default(PENDING)
  mode          ApprovalMode  @default(ANY)
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  decidedAt     DateTime?

  post  Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  steps ApprovalStep[]

  @@index([workspaceId, state])
}

/// One approver's decision. Kept even after the approval resolves — an approval
/// history that only records the final outcome cannot answer "who signed off".
model ApprovalStep {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String        @db.Uuid
  approvalId  String        @db.Uuid
  approverId  String        @db.Uuid
  order       Int           @default(0)
  decision    ApprovalState @default(PENDING)
  note        String?
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, approverId])
  @@index([workspaceId, decision])
}

/// Threaded internal notes on a post. Never leaves the workspace.
model PostComment {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @db.Uuid
  postId      String    @db.Uuid
  authorId    String?   @db.Uuid
  parentId    String?   @db.Uuid
  body        String
  mentions    String[]
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  PostComment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies PostComment[] @relation("Thread")

  @@index([workspaceId, postId, createdAt])
}

/// In-app notifications.
model Notification {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @db.Uuid
  userId      String    @db.Uuid
  kind        String
  title       String
  body        String?
  /// Deep link into the app, so a notification is actionable rather than a fact.
  href        String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  /// See WebhookDelivery.dedupeKey — same reason, same at-least-once guarantee.
  dedupeKey   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Platform surface
// ---------------------------------------------------------------------------

/// Scoped API keys.
///
/// Only the HASH is stored; the secret is shown once at creation and never
/// again. The prefix is kept separately so a person can tell two keys apart in
/// a list without the secret being recoverable.
model ApiKey {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  organizationId String    @db.Uuid
  name           String
  keyHash        String    @unique
  prefix         String
  scopes         String[]
  createdById    String?   @db.Uuid
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([workspaceId, revokedAt])
}

/// Outbound webhook endpoint.
model Webhook {
  id                  String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId         String    @db.Uuid
  organizationId      String    @db.Uuid
  url                 String
  events              String[]
  /// Encrypted at rest like any other credential.
  signingSecret       String
  enabled             Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  disabledAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  deliveries WebhookDelivery[]

  @@index([workspaceId, enabled])
}

/// Every attempt, kept. "Why did my endpoint not fire?" is unanswerable without
/// a record of what we sent and what came back.
model WebhookDelivery {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  webhookId      String    @db.Uuid
  eventType      String
  payload        Json
  attempt        Int       @default(1)
  responseStatus Int?
  responseBody   String?
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  /// Natural key for the side effect that produced this row.
  ///
  /// Outbox delivery is at-least-once by design: the dispatcher can crash after
  /// writing this row and before marking the event dispatched, and the only safe
  /// response is to run again. Without this, running again sends the same event
  /// a second time. With it, the unique index turns the retry into a no-op.
  ///
  /// Nullable, because rows created by anything other than the dispatcher have
  /// no such key and must not be forced to invent one.
  dedupeKey      String?

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([dedupeKey])
  @@index([webhookId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([deliveredAt, nextRetryAt])
}

// ---------------------------------------------------------------------------
// Link in bio
// ---------------------------------------------------------------------------

model LinkPage {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  organizationId String    @db.Uuid
  /// Globally unique: the public URL is /l/:slug, with no tenant in the path.
  slug           String    @unique
  title          String
  bio            String?
  avatarUrl      String?
  theme          String    @default("default")
  published      Boolean   @default(false)
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  links Link[]

  @@index([workspaceId, deletedAt])
}

model Link {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @db.Uuid
  linkPageId  String   @db.Uuid
  label       String
  url         String
  position    Int      @default(0)
  clicks      Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())

  page LinkPage @relation(fields: [linkPageId], references: [id], onDelete: Cascade)

  @@index([linkPageId, position])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// RSS automation
// ---------------------------------------------------------------------------

model RSSFeed {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId      String    @db.Uuid
  organizationId   String    @db.Uuid
  url              String
  name             String
  /// Accounts each new item is published to.
  targetAccountIds String[]
  /// Prefixed to the item title when composing.
  template         String    @default("{{title}} {{link}}")
  /// Items are created as drafts by default. Auto-publishing from a feed you do
  /// not control is how someone else's headline ends up on your brand account.
  autoPublish      Boolean   @default(false)
  lastFetchedAt    DateTime?
  lastItemGuid     String?
  pausedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  items RSSItem[]

  @@index([workspaceId, deletedAt])
  @@index([pausedAt, lastFetchedAt])
}

/// Seen items, so a feed that re-orders or re-publishes cannot repost.
model RSSItem {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @db.Uuid
  feedId      String    @db.Uuid
  guid        String
  title       String
  link        String
  publishedAt DateTime?
  postId      String?   @db.Uuid
  createdAt   DateTime  @default(now())

  feed RSSFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  /// The dedupe key. A feed re-publishing an item with the same guid is the
  /// normal case, not an edge case.
  @@unique([feedId, guid])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Unified inbox
// ---------------------------------------------------------------------------

enum ConversationKind {
  COMMENT_THREAD
  DM
  MENTION
}

enum ConversationStatus {
  OPEN
  SNOOZED
  ARCHIVED
}

model Conversation {
  id                     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId            String             @db.Uuid
  organizationId         String             @db.Uuid
  socialAccountId        String             @db.Uuid
  providerConversationId String
  kind                   ConversationKind
  subjectHandle          String
  status                 ConversationStatus @default(OPEN)
  assigneeId             String?            @db.Uuid
  priority               Int                @default(0)
  lastMessageAt          DateTime           @default(now())
  unreadCount            Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  messages      Message[]

  @@unique([socialAccountId, providerConversationId])
  @@index([workspaceId, status, lastMessageAt])
  @@index([assigneeId, status])
}

model Message {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId       String   @db.Uuid
  conversationId    String   @db.Uuid
  providerMessageId String
  /// IN from the audience, OUT from us.
  direction         String
  authorHandle      String
  body              String
  mediaUrls         String[]
  /// ORDERING USES THIS, never arrival order — out-of-order webhook delivery is
  /// expected, not exceptional.
  providerCreatedAt DateTime
  parentId          String?  @db.Uuid
  raw               Json?
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, providerMessageId])
  @@index([conversationId, providerCreatedAt])
}

/// Gap recovery. Webhooks lose events, so a slow poll fetches since the cursor
/// and inserts whatever was missed — deduplicated by the same unique index.
/// This is also the ONLY path for providers with no webhook support, so polling
/// and webhooks converge on one write path rather than two.
model SyncCursor {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String    @db.Uuid
  socialAccountId String    @db.Uuid
  resource        String
  cursor          String?
  lastSyncedAt    DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([socialAccountId, resource])
  @@index([workspaceId])
}

/// An inbound provider event, stored ONCE and fanned out.
///
/// Because SocialAccount uniqueness is per workspace, one provider event can be
/// relevant to several workspaces — the agency case. Storing the payload once
/// and fanning out to delivery rows keeps a single copy of the data, gives each
/// workspace its own processing state, and makes multi-routed events visible in
/// admin rather than looking like duplicates.
model InboundEvent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider        String
  providerEventId String?
  contentHash     String
  signatureValid  Boolean   @default(false)
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  deliveries InboundEventDelivery[]

  @@unique([provider, providerEventId])
  @@unique([provider, contentHash])
  @@index([receivedAt])
}

model InboundEventDelivery {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  inboundEventId  String    @db.Uuid
  workspaceId     String    @db.Uuid
  socialAccountId String    @db.Uuid
  status          String    @default("PENDING")
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  event InboundEvent @relation(fields: [inboundEventId], references: [id], onDelete: Cascade)

  @@unique([inboundEventId, workspaceId])
  @@index([workspaceId, status])
}

/// Events matching no connected account. Dropped, never guessed at, never
/// broadcast, never attached to the nearest plausible workspace. Volume is an
/// admin metric — a sustained rise means a stale subscription needs cleaning up.
model UnroutedInboundEvent {
  id                String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider          String
  providerAccountId String?
  payload           Json
  receivedAt        DateTime @default(now())

  @@index([receivedAt])
}

/// A single-use, time-limited token for password reset and email verification.
///
/// The token is stored HASHED, exactly like a session id or an API key. A
/// database leak that hands out working password-reset links is the same breach
/// as one that hands out passwords, and there is no reason to hold the plaintext
/// once it has been sent.
///
/// Not tenant-scoped: it belongs to a USER, who exists before any workspace and
/// may belong to several.
model VerificationToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @db.Uuid
  /// sha256 of the token that was sent. Never the token itself.
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  /// Set the moment it is spent, so a replay is refused rather than honoured.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// A re-encoded copy of a MediaAsset, conforming to one provider surface.
///
/// Cached on (assetId, providerId, surface) rather than on the post. The same
/// video going to Instagram Reels from four different posts is ONE transcode —
/// a key that included the post would redo it every time, which for a
/// two-minute encode is the difference between a usable tool and an unusable
/// one.
model MediaRendition {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String   @db.Uuid
  organizationId String   @db.Uuid
  mediaAssetId   String   @db.Uuid
  providerId     String
  surface        String
  storageKey     String   @unique
  mime           String
  bytes          Int
  /// What was changed and why, shown while the variant sits in PREPARING_MEDIA.
  reasons        String[]
  createdAt      DateTime @default(now())

  asset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([mediaAssetId, providerId, surface])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Organisation — campaigns, labels, templates, UTM presets
// ---------------------------------------------------------------------------

/// A named grouping of posts, with dates.
///
/// The dates are DESCRIPTIVE, not enforcing. A campaign that ran 1–14 August
/// does not stop you attaching a post from the 15th, because that is exactly
/// what a follow-up is, and a tool that refuses it teaches people to keep the
/// real dates in a spreadsheet instead.
model Campaign {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  /// A hex colour so the calendar can band a campaign at a glance.
  color          String    @default("#6366f1")
  startsAt       DateTime?
  endsAt         DateTime?
  /// Archived rather than deleted: a finished campaign still owns its history.
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@unique([workspaceId, name])
  @@index([workspaceId, archived, deletedAt])
}

/// A free-form tag on a post.
///
/// Separate from campaigns on purpose. A post belongs to ONE campaign and any
/// number of labels, because "which initiative was this part of" and "what kind
/// of thing is it" are different questions. Collapsing them into one tag system
/// is why tag lists become unusable after a year.
model Label {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String   @db.Uuid
  organizationId String   @db.Uuid
  name           String
  color          String   @default("#64748b")
  createdAt      DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     PostLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

/// Join row. Cascades from both sides — it carries no meaning of its own.
model PostLabel {
  postId      String   @db.Uuid
  labelId     String   @db.Uuid
  workspaceId String   @db.Uuid
  createdAt   DateTime @default(now())

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([postId, labelId])
  @@index([workspaceId, labelId])
}

/// Reusable content with {{variables}}.
///
/// The body is stored EXACTLY as written, placeholders intact. Rendering
/// happens at use time against values the author supplies, and a template with
/// unfilled variables is refused rather than published with holes in it — see
/// packages/content/src/template.ts for why neither obvious fallback is safe.
model Template {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String    @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  body           String
  /// Denormalised from the body on write, so listing templates does not mean
  /// parsing every one of them. Rewritten whenever the body changes.
  variables      String[]  @default([])
  createdById    String?   @db.Uuid
  /// Incremented when a template is used. Sorts the list by what people
  /// actually reach for rather than by what was made most recently.
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name])
  @@index([workspaceId, deletedAt, usageCount])
}

/// A saved set of UTM parameters, each value itself templatable.
///
/// source and medium are required because a UTM tag missing either is not
/// usable in any analytics tool worth the name — it lands in the "(not set)"
/// bucket, which is where attribution goes to die.
model UtmPreset {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String   @db.Uuid
  organizationId String   @db.Uuid
  name           String
  source         String
  medium         String
  campaign       String?
  term           String?
  content        String?
  /// At most one per workspace, enforced in the service rather than by a
  /// partial unique index, because clearing the old default and setting the new
  /// one has to happen in one transaction either way.
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@index([workspaceId, isDefault])
}

// ---------------------------------------------------------------------------
// Export
// ---------------------------------------------------------------------------

enum ExportKind {
  /// Everything the workspace owns: posts, variants, a media manifest, metrics.
  WORKSPACE
  /// Everything tied to ONE end-user identity across every conversation in this
  /// workspace. The subject-access request, in other words.
  SUBJECT
}

enum ExportStatus {
  PENDING
  RUNNING
  READY
  FAILED
  /// The file is gone. Kept as a row because "an export of your DMs existed and
  /// was downloaded twice" is a fact worth being able to answer later.
  EXPIRED
}

/// A request for a copy of some data, fulfilled asynchronously.
///
/// Asynchronous because it has to be. A workspace with a year of history and
/// fifty thousand messages is not a request handler's problem, and the two
/// alternatives are both bad: a synchronous endpoint that times out on exactly
/// the workspaces most likely to need it, or a streaming response that cannot
/// be retried when it breaks halfway.
///
/// SUBJECT exports are scoped to one workspace, always. "Everything you hold
/// about this person" spanning tenants would answer a legitimate question by
/// committing a cross-tenant leak — each controller answers for its own data.
model ExportJob {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String       @db.Uuid
  organizationId String       @db.Uuid
  kind           ExportKind
  /// The identity being exported, for SUBJECT. Null for WORKSPACE.
  subjectHandle  String?
  status         ExportStatus @default(PENDING)
  requestedById  String?      @db.Uuid
  /// Where the finished file lives. Null until READY.
  storageKey     String?
  bytes          Int?
  /// Row counts per section, so a recipient can tell an empty export from a
  /// broken one — the single most common question about any export.
  summary        Json?
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// After this the file is deleted and the row moves to EXPIRED. An export of
  /// somebody's private messages should not sit in object storage forever
  /// because one person forgot to download it.
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, createdAt])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Recurrence
// ---------------------------------------------------------------------------

enum RecurrenceFreq {
  DAILY
  WEEKLY
  MONTHLY
}

/// A repeating schedule, and the template it repeats.
///
/// The rule stores a WALL-CLOCK TIME and an IANA ZONE rather than an instant
/// and an interval. That is the whole design: "09:00 Europe/Berlin" survives a
/// daylight-saving change, whereas "this instant, every 24 hours" starts
/// landing an hour out and never stops. See packages/content/src/recurrence.ts.
///
/// The template lives on this row rather than pointing at a Post, because a
/// template Post would appear on the calendar as something publishable and
/// somebody would eventually publish it.
model Recurrence {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String         @db.Uuid
  organizationId String         @db.Uuid
  name           String
  freq           RecurrenceFreq
  interval       Int            @default(1)
  /// 0 is Sunday. Empty means the weekday the rule starts on.
  byWeekday      Int[]          @default([])
  /// 1-31, or -1 for the last day of the month.
  byMonthDay     Int?
  hour           Int
  minute         Int
  /// IANA zone. Not an offset: an offset cannot express "this zone observes DST".
  timezone       String
  /// Local calendar dates, 'YYYY-MM-DD'. Not instants — a rule starts on a DAY.
  startsOn       String
  endsOn         String?
  /// What each occurrence publishes.
  content        String
  /// Which accounts it goes to. Ids, resolved at expansion so a disconnected
  /// account produces a post with a missing variant rather than a failed job.
  accountIds     String[]       @default([])
  active         Boolean        @default(true)
  /// How far the expansion has materialised. Lets the job ask only for what is
  /// new instead of re-walking the whole horizon on every tick.
  expandedUntil  DateTime?
  createdById    String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  posts     Post[]

  @@index([workspaceId, active, deletedAt])
  @@index([active, expandedUntil])
}

// ---------------------------------------------------------------------------
// Installation settings
// ---------------------------------------------------------------------------

/// An operator-supplied connector credential — a Meta app secret, a Google
/// client ID — set through the admin UI instead of the environment.
///
/// DEPLOYMENT-GLOBAL, and deliberately not tenant-scoped. A Meta app
/// registration is a property of the installation: the adapters that consult it
/// run in OAuth callbacks and background jobs that have no workspace in hand,
/// and giving each workspace its own Meta app would mean every customer
/// registering with Meta themselves, which is the thing this software exists to
/// avoid. The consequence is stated on screen rather than hidden — on a
/// deployment hosting more than one organization, changing these is refused
/// unless the operator opts in explicitly, because one org's admin must not
/// silently repoint another org's connector.
///
/// The value is envelope-encrypted with the same KEK as OAuth tokens. It is
/// never returned by the API — `hint` is what the UI displays.
model ProviderSetting {
  /// The environment-variable name this overrides, e.g. META_APP_SECRET.
  /// Restricted to a declared allowlist at the API, so this cannot become a
  /// way to set arbitrary process configuration.
  key         String   @id
  /// AES-256-GCM envelope ciphertext: { v, keyId, iv, tag, ciphertext }.
  value       String
  /// Which KEK wrapped this record's DEK, so rotation can find what to re-wrap.
  keyId       String
  /// What the UI shows in place of the value: the whole thing for an ID, the
  /// last four characters for a secret. Enough to answer "is the right value in
  /// here?" without the answer being readable by anyone who reaches the API.
  hint        String
  updatedById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/// A recurring time-of-week this workspace publishes at.
///
/// The "queue" model: instead of picking a datetime for every post, a workspace
/// declares when it posts — Tuesdays at 09:00, weekdays at 17:30 — and new posts
/// drop into the next free one. For anyone posting on a rhythm this is the
/// difference between choosing a time forty times a week and choosing it once.
///
/// A WALL-CLOCK TIME plus the workspace's zone, never an instant, for exactly
/// the reason recurrence stores one: "09:00 on Tuesdays" must survive a
/// daylight-saving change, and an instant plus an interval does not.
///
/// Deliberately NOT per-account. A slot is when this workspace has its audience's
/// attention, which is a property of the audience rather than of a connector, and
/// per-account slots multiply the thing being simplified. A post going to four
/// channels occupies one slot.
model PostingSlot {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId    String   @db.Uuid
  organizationId String   @db.Uuid
  /// 0 is Sunday, matching Date.getDay() so no conversion is needed anywhere.
  dayOfWeek      Int
  hour           Int
  minute         Int
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// One slot per moment. Two slots at the same time would hand out the same
  /// instant to two posts and publish them together, which is the opposite of
  /// what a queue is for.
  @@unique([workspaceId, dayOfWeek, hour, minute])
  @@index([workspaceId])
}

/// A day of metrics, already aggregated.
///
/// The plan is explicit that dashboards read snapshots and never raw rows, and
/// until now they read raw rows: the analytics endpoint ran a DISTINCT ON over
/// every PostMetric captured in the window, on every page load. That is fine at
/// demo scale and gets worse every hour the ingestion job runs, because the
/// table it scans only ever grows.
///
/// One row per workspace per day per account. `socialAccountId` null means the
/// whole workspace — the totals a dashboard actually opens with, precomputed
/// rather than summed across accounts at read time.
///
/// Deliberately NOT a cache. It is derived from PostMetric and can be rebuilt
/// from it, but it is the read model: retention nulls raw payloads after 90 days
/// and rolls hourly metrics to daily after 30, so a year-old chart can only come
/// from here. Rebuilding is idempotent — the unique index makes a re-run of any
/// day replace it rather than double it.
model AnalyticsSnapshot {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId     String    @db.Uuid
  organizationId  String    @db.Uuid
  /// Midnight UTC of the day being summarised. A day is a UTC day here, not a
  /// workspace-local one: two workspaces in different zones sharing an account
  /// would otherwise disagree about which day a metric belongs to.
  day             DateTime
  /// Null for the workspace total across every account.
  socialAccountId String?   @db.Uuid
  postsPublished  Int       @default(0)
  impressions     Int?
  reach           Int?
  likes           Int?
  comments        Int?
  shares          Int?
  saves           Int?
  clicks          Int?
  videoViews      Int?
  followers       Int?
  /// Averaged across the variants measured that day, not summed — a rate that
  /// adds up is not a rate.
  engagementRate  Float?
  /// How many variants contributed, so a day built from two posts is not read
  /// as confidently as one built from two hundred.
  sampleSize      Int       @default(0)
  computedAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day, socialAccountId])
  @@index([workspaceId, day])
}
