{
  "name": "@smm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --conditions development --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@smm/auth": "workspace:*",
    "@smm/config": "workspace:*",
    "@smm/content": "workspace:*",
    "@smm/observability": "workspace:*",
    "@smm/database": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "fastify": "^4.28.1",
    "@fastify/cookie": "^9.4.0",
    "zod": "^3.23.8",
    "@fastify/static": "^7.0.4",
    "@smm/providers": "workspace:*",
    "@smm/ratelimit": "workspace:*",
    "ioredis": "^5.4.1",
    "@smm/publishing": "workspace:*",
    "@smm/storage": "workspace:*",
    "@smm/integrations": "workspace:*",
    "@smm/mail": "workspace:*"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1"
  }
}
