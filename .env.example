# =============================================================================
#  SMM — environment configuration
#  Copy to .env and fill in. Variables marked REQUIRED must be set or the
#  application refuses to boot (see packages/config env schema).
# =============================================================================

# --- REQUIRED: core infrastructure -------------------------------------------
# TWO connection strings, deliberately.
#
# The application connects as an UNPRIVILEGED role. Superusers bypass row-level
# security unconditionally, and FORCE ROW LEVEL SECURITY does not change that —
# it only removes the table owner's exemption. Connecting as the owner would
# make every tenant-isolation policy silently inert while still appearing
# correctly configured. The app refuses to boot if it detects it can bypass RLS.
DATABASE_URL=postgresql://smm_app_user:CHANGE_ME@postgres:5432/smm

# Owner credentials. Used ONLY by the one-shot migrate service; never by the
# app or the worker. Compose builds this from the POSTGRES_* values below, so
# with the bundled stack you do not set it yourself.
MIGRATE_DATABASE_URL=

# --- REQUIRED: the bundled Postgres, Redis and MinIO --------------------------
# These configure the containers in docker-compose.yml. Compose REFUSES to start
# if any is unset — there is deliberately no default, because a compose file
# that boots with POSTGRES_PASSWORD=smm is one somebody deploys unchanged.
#
#   openssl rand -base64 24
POSTGRES_USER=smm
POSTGRES_PASSWORD=
POSTGRES_DB=smm

REDIS_PASSWORD=

# The migrate service provisions the application role with these.
APP_DB_USER=smm_app_user
APP_DB_PASSWORD=CHANGE_ME

# Must carry the password set above: redis://:PASSWORD@redis:6379
# Must carry the password set above: redis://:PASSWORD@redis:6379
REDIS_URL=

# REQUIRED. 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# The app refuses to boot if this is missing, short, or left as the example.
ENCRYPTION_KEY=

# Set only during key rotation; the previous KEK stays readable until all
# records are re-wrapped. Remove once the rotation job reports complete.
ENCRYPTION_KEY_PREVIOUS=

# REQUIRED. 32 random bytes, base64. openssl rand -base64 32
SESSION_SECRET=

# --- REQUIRED: URLs ----------------------------------------------------------
# Public origin the browser reaches. Drives cookie policy (see below),
# OAuth redirect URIs, inbound webhook reachability, and media relay URLs.
PUBLIC_URL=http://localhost:3000

# Server-to-server address for apps/web -> apps/api, bypassing the proxy hop.
INTERNAL_API_URL=http://api:3001

# Cookie/TLS policy. With an https PUBLIC_URL the session cookie uses the
# __Host- prefix and Secure. With http on a non-localhost host the app REFUSES
# to boot unless this is explicitly set to true, and then warns on every boot.
ALLOW_INSECURE_COOKIES=false

# --- REQUIRED: object storage (S3-compatible) --------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=smm-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# How platforms that PULL media (Instagram) reach our files.
#   presigned-s3 : storage is itself internet-reachable  (fewest hops)
#   relay        : only the app is public; stream via /api/v1/media/relay/:token
#   disabled     : nothing is public. Instagram is marked unavailable at boot.
MEDIA_PUBLIC_MODE=relay

# --- Behaviour ---------------------------------------------------------------
# open | invite | closed. First account on an empty DB always becomes owner.
AUTH_REGISTRATION=invite

# poll | webhook | auto  — auto probes PUBLIC_URL reachability at boot and
# COMMITS to one. It cannot mean "try both": for some providers (Telegram) the
# two are mutually exclusive, and calling getUpdates while a webhook is set is
# an error rather than a fallback.
INBOUND_MODE=auto

# Posts overdue by more than this are marked MISSED rather than burst-published.
CATCHUP_WINDOW_MINUTES=60

# Days before a soft-deleted workspace is purged. Surfaced in the UI.
WORKSPACE_PURGE_GRACE_DAYS=30

# Blank = unlimited. Per-workspace override available in settings.
INBOX_RETENTION_DAYS=

LOG_LEVEL=info
NODE_ENV=development

# =============================================================================
#  Provider credentials — ALL OPTIONAL.
#  A provider without credentials is marked `configured: false`, disabled in
#  the connect UI, and never crashes the app. Nobody self-hosting configures
#  all of these, and most start with none.
# =============================================================================

# --- No approval required (works immediately) --------------------------------
# Mastodon registers its client dynamically per instance; nothing to set here.
TELEGRAM_BOT_TOKEN=
BLUESKY_SERVICE_URL=https://bsky.social
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- Self-service developer app (no partner review) --------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TUMBLR_CLIENT_ID=
TUMBLR_CLIENT_SECRET=

# --- Paid / metered ----------------------------------------------------------
# X is pay-per-use: ~$0.015/post, ~$0.20/post containing a URL.
# The composer shows an estimated cost; set a spend cap per workspace in settings.
X_CLIENT_ID=
X_CLIENT_SECRET=

# --- Requires platform review / audit ----------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Inbound webhook secrets -------------------------------------------------
# A provider whose secret is UNSET refuses to receive inbound events at all. It
# does not accept unsigned ones "until configured" — that would turn a public,
# unauthenticated endpoint into an open write into somebody's inbox.
#
# Publishing works without these. Only inbound delivery is affected, so leave
# them blank until you have a public URL and have registered the subscription.

# Telegram: a secret_token of your choosing, up to 256 characters, echoed back
# in X-Telegram-Bot-Api-Secret-Token. Telegram does NOT sign the body, so a
# leaked secret allows forging arbitrary content — treat it as a credential.
TELEGRAM_WEBHOOK_SECRET=

# The mock provider's inbound path, for demos and local testing. Real HMAC over
# real bytes, so exercising it exercises the actual receiver rather than a stub.
MOCK_WEBHOOK_SECRET=

# --- Mail --------------------------------------------------------------------
# OPTIONAL, and its absence is a supported configuration rather than an error:
# plenty of self-hosted deployments have no mail server.
#
# Without SMTP_URL, password-reset and email-confirmation links are written to
# the SERVER LOG and the sign-in page says so. They are never silently
# discarded, and never presented as though an email were on its way.
SMTP_URL=
MAIL_FROM=

# --- Serving ------------------------------------------------------------------
# Host port for the web container. The ONLY port published by default.
#
# Put a TLS-terminating reverse proxy in front of it for anything reachable
# beyond a trusted network. Without https the session cookie loses Secure and
# the __Host- prefix, and the API says so loudly at every boot.
WEB_PORT=3000

# How long the API drains in-flight requests on SIGTERM before exiting anyway.
# Keep it BELOW the orchestrator's stop_grace_period, or the drain is cut short
# by a SIGKILL and the graceful shutdown is decorative.
SHUTDOWN_GRACE_MS=15000

# --- Observability ---------------------------------------------------------
# Bearer token for GET /api/v1/metrics and the worker's :9464/metrics.
#
# Optional. An unauthenticated scrape on a private network is a legitimate
# setup, so this is not required — but left unset on an internet-facing
# deployment the API warns on every boot rather than letting you find out from
# a scan. What it exposes is operational volume and error rates, never message
# content or handles.
# METRICS_TOKEN=

# Port the worker serves its own metrics on. The API's live under /api/v1.
# WORKER_METRICS_PORT=9464
