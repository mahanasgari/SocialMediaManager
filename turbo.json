{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_OWNER_URL",
        "TEST_REDIS_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "ENCRYPTION_KEY",
        "SESSION_SECRET",
        "PUBLIC_URL",
        "INTERNAL_API_URL",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_REGION"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "env": [
        "TEST_DATABASE_URL",
        "TEST_DATABASE_OWNER_URL",
        "DATABASE_URL",
        "REDIS_URL",
        "ENCRYPTION_KEY",
        "SESSION_SECRET",
        "PUBLIC_URL",
        "INTERNAL_API_URL",
        "S3_ENDPOINT",
        "S3_BUCKET",
        "S3_ACCESS_KEY_ID",
        "S3_SECRET_ACCESS_KEY",
        "S3_REGION"
      ]
    },
    "test:e2e": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "CI"
  ]
}
